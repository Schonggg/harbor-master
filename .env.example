# LLM — OpenAI-compatible (Gonka router, OpenAI, Azure, …)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.gonkarouter.io/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
OPENAI_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,MiniMaxAI/MiniMax-M2.7,zai-org/GLM-5.3-Flash
VISION_MODEL=zai-org/GLM-5.3-Flash

# Official 520-email bundle (inbox JSON + attachments). Used when the HTTP inbox is down.
SDOC_BUNDLE_DIR=./data/sdoc

# Optional live inbox API (read-only sponsor service)
INBOX_BASE_URL=http://localhost:8080

# Runtime
HARBORMASTER_ENV=dev
DATA_DIR=./data
# Hosted Postgres (Supabase). Vercel disk is ephemeral — do not use SQLite in prod.
# Dashboard → Connect → URI → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DB_PATH=./data/harbormaster.db
CONFIG_DIR=./config
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Optional service key. Empty = open demo. Set this in production and pass
# X-API-Key (the Bridge also accepts ?key= once; same-origin UI is exempt).
# Additional rotatable keys can be issued from Metrics → System (stored hashed).
HARBORMASTER_API_KEY=

# Object storage. Empty S3_BUCKET = local disk at DATA_DIR/objects.
# Compatible with AWS S3, Cloudflare R2, MinIO.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=harbormaster/
S3_FORCE_PATH_STYLE=true

# Timed SQLite snapshot + object-store offload. 0 = manual backups only.
BACKUP_INTERVAL_HOURS=0
WORKER_THREADS=2
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=8

# Autonomy dial (overridden by config/thresholds.yaml at boot)
AUTONOMY_MATCH_THRESHOLD=0.92
AUTONOMY_UNCERTAIN_BAND=0.08

# Chaos (demo only)
CHAOS_ENABLED=false
