node_modules/

# Eval artifacts (keep snapshots/ tracked selectively)
eval/snapshots/*.json
!eval/snapshots/.gitkeep

# Coverage / cache
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vercel
.env.local
!.env.example
